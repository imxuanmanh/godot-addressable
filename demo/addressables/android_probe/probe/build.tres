[gd_resource type="Resource" script_class="AddressablesBuild" load_steps=7 format=3]

[ext_resource type="Script" path="res://addons/addressables/editor/content_build.gd" id="build"]
[ext_resource type="Script" path="res://addons/addressables/editor/content_group.gd" id="group"]
[ext_resource type="Script" path="res://addons/addressables/runtime/asset_reference.gd" id="reference"]
[ext_resource type="Resource" path="res://probe/references/hero.tres" id="hero"]
[ext_resource type="Resource" path="res://probe/references/big.tres" id="big"]

[sub_resource type="Resource" id="hero_group"]
script = ExtResource("group")
group_name = "hero"
assets = Array[ExtResource("reference")]([ExtResource("hero")])

[sub_resource type="Resource" id="big_group"]
script = ExtResource("group")
group_name = "big"
assets = Array[ExtResource("reference")]([ExtResource("big")])

[resource]
script = ExtResource("build")
groups = Array[ExtResource("group")]([SubResource("hero_group"), SubResource("big_group")])
output_directory = "res://probe/content"
target_platform = "Android"
