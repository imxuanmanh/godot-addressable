extends RefCounted
## Runs inside the native EditorPlugin driver generated by run_tests.py.
## Checks real Inspector widgets, serialization, UID resolution, packing and schema validation.
## All edited assets belong to an isolated fixture project.

const Builder = preload("../editor/content_builder.gd")
const Catalog = preload("../runtime/catalog.gd")
const Property = preload("../editor/reference_property.gd")
const ArrayProperty = preload("../editor/reference_array_property.gd")
var checks := 0
var tree: SceneTree
var root: Window


func check(value: bool, message: String) -> void:
	checks += 1
	if not value:
		push_error("CHECK FAILED: " + message)
		tree.quit(1)


func has_property_editor(node: Node, script: Script) -> bool:
	if node is EditorProperty and node.get_script() == script:
		return true
	for child in node.get_children():
		if has_property_editor(child, script):
			return true
	return false


func run(scene_tree: SceneTree) -> void:
	tree = scene_tree
	root = tree.root
	await _run()


func _run() -> void:
	# Let the real editor finish initializing before exercising its property controls.
	if Engine.is_editor_hint():
		for frame in range(6):
			await tree.process_frame
		while EditorInterface.get_resource_filesystem().is_scanning():
			await tree.process_frame
	var a := AddressableReference.from_path("res://fixtures/a.tscn")
	a.key = "asset/a"
	a.expected_type = "PackedScene"
	var b := AddressableReference.from_path("res://fixtures/b.tscn")
	b.key = "asset/b"
	b.expected_type = "PackedScene"
	check(not a.key.is_empty() and a.resolve_source() == "res://fixtures/a.tscn", "reference resolution")
	var uid_reference := AddressableReference.from_path("res://fixtures/a.svg")
	check(uid_reference.key.begins_with("uid://"), "use imported resource UID")
	var uid := ResourceUID.text_to_id(uid_reference.key)
	ResourceUID.set_id(uid, "res://fixtures/renamed.svg")
	check(uid_reference.resolve_source() == "res://fixtures/renamed.svg", "UID reference follows rename mapping")
	ResourceUID.set_id(uid, "res://fixtures/a.svg")
	var host: Node = load("res://host.gd").new()
	host.name = "ReferenceOwner"
	host.asset = a
	EditorInterface.inspect_object(host)
	for frame in range(3):
		await tree.process_frame
	check(has_property_editor(EditorInterface.get_inspector(), Property), "plugin installs real single-reference Inspector editor")
	var packed := PackedScene.new()
	check(packed.pack(host) == OK, "pack reference owner")
	check(ResourceSaver.save(packed, "res://host.tscn") == OK, "save reference owner")
	var serialized := FileAccess.get_file_as_string("res://host.tscn")
	check(serialized.contains('key = "asset/a"'), "serialized stable string key")
	check(not serialized.contains('[ext_resource type="PackedScene"'), "no hard scene dependency")
	check(not ResourceLoader.get_dependencies("res://host.tscn").has("res://fixtures/a.tscn"), "light reference not dependency")
	ResourceSaver.save(a, "res://asset_reference.tres")
	check(ResourceLoader.load("res://asset_reference.tres").key == "asset/a", "reference round trip")
	var editor := Property.new()
	root.add_child(editor)
	editor.set_object_and_property(host, "asset")
	editor.property_changed.connect(func(property: StringName, value: Variant, _field: StringName, _changing: bool):
		host.set(property, value))
	var drop := {"type": "files", "files": PackedStringArray(["res://fixtures/b.tscn"])}
	check(editor._can_drop_asset(Vector2.ZERO, drop), "accept resource file drop")
	editor._drop_asset(Vector2.ZERO, drop)
	check(host.asset is AddressableReference and host.asset.source_path == "res://fixtures/b.tscn", "drop creates lightweight reference")
	check(not editor._can_drop_asset(Vector2.ZERO, {"type": "files", "files": PackedStringArray(["res://missing.tscn"])}), "reject missing drop")
	check(not editor._can_drop_asset(Vector2.ZERO, {"type": "files", "files": PackedStringArray(["res://fixtures/a.tscn", "res://fixtures/b.tscn"])}), "reject multiple drop")
	check(editor._can_drop_asset(Vector2.ZERO, {"type": "resource", "resource": load("res://fixtures/a.tscn")}), "accept inspector resource drag")
	check(not editor._can_drop_asset(Vector2.ZERO, {"type": "files", "files": ["res://host.gd"]}), "reject script as remote asset")
	editor._set_read_only(true)
	check(not editor._can_drop_asset(Vector2.ZERO, drop), "read-only inspector")
	editor.free()
	host.free()
	var group_a := AddressableGroup.new()
	group_a.group_name = "group_a"
	group_a.assets.assign([a])
	EditorInterface.edit_resource(group_a)
	for frame in range(3):
		await tree.process_frame
	check(has_property_editor(EditorInterface.get_inspector(), ArrayProperty), "plugin installs real group Inspector editor")
	var array_editor := ArrayProperty.new()
	root.add_child(array_editor)
	array_editor.set_object_and_property(group_a, "assets")
	array_editor.property_changed.connect(func(property: StringName, value: Variant, _field: StringName, _changing: bool):
		group_a.set(property, value))
	var multiple := {"type": "files", "files": ["res://fixtures/a.tscn", "res://fixtures/b.tscn"]}
	check(array_editor._can_drop_assets(Vector2.ZERO, multiple), "group accepts multiple asset files")
	array_editor._drop_assets(Vector2.ZERO, multiple)
	check(group_a.assets.size() == 3, "group appends references with distinct keys")
	array_editor._drop_assets(Vector2.ZERO, multiple)
	check(group_a.assets.size() == 3, "group does not append same reference twice")
	array_editor._set_read_only(true)
	check(not array_editor._can_drop_assets(Vector2.ZERO, multiple), "read-only group")
	array_editor.free()
	group_a.assets.assign([a])
	var group_b := AddressableGroup.new()
	group_b.group_name = "group_b"
	group_b.assets.assign([b])
	var settings := AddressablesBuild.new()
	settings.output_directory = "res://content"
	settings.groups.assign([group_a, group_b])
	check(ResourceSaver.save(settings, "res://content_build.tres", ResourceSaver.FLAG_CHANGE_PATH) == OK, "save build settings")
	var built: Dictionary = Builder.build(settings)
	check(not built.has("error"), "build succeeds: " + str(built.get("error", "")))
	if built.has("error"):
		return
	var catalog: Dictionary = built.catalog
	check(Catalog.validate(catalog).is_empty(), "valid built catalog")
	check(catalog.packs.size() == 3 and catalog.packs.has("__shared"), "extract shared dependency pack")
	check(catalog.packs.group_a.dependencies == ["__shared"], "asset depends on shared pack")
	var files: Dictionary = {}
	for pack in catalog.packs.values():
		check(pack.sha256 == FileAccess.get_sha256("res://content/" + pack.file), "pack checksum")
		for path in pack.files:
			check(not files.has(path), "no duplicate resource between packs")
			files[path] = true
	check(files.has("res://fixtures/shared.svg.import"), "include import remap")
	check(str(files.keys()).contains(".ctex"), "include imported texture")
	check(not files.has("res://base_asset.gd") and "res://base_asset.gd" in catalog.base_dependencies, "script dependency remains in base")
	check(not Builder.build(settings).has("error"), "repeat build succeeds")
	check(FileAccess.file_exists(Builder.EXPORT_STATE), "write export filter state")
	group_b.group_name = "group_a"
	check(Builder.build(settings).has("error"), "reject duplicate group")
	group_b.group_name = "../escape"
	check(Builder.build(settings).has("error"), "reject unsafe group name")
	group_b.group_name = "group_b"
	b.key = "asset/a"
	check(Builder.build(settings).has("error"), "reject conflicting address")
	b.key = "asset/b"
	b.expected_type = "AudioStream"
	check(Builder.build(settings).has("error"), "reject wrong reference type")
	b.expected_type = "PackedScene"
	var mutated: Dictionary = catalog.duplicate(true)
	mutated.assets["asset/a"].path = "res://../escape.tscn"
	check(not Catalog.validate(mutated).is_empty(), "reject path traversal")
	mutated = catalog.duplicate(true)
	mutated.packs.group_a.dependencies = ["missing"]
	check(not Catalog.validate(mutated).is_empty(), "reject missing dependency")
	mutated = catalog.duplicate(true)
	mutated.packs.__shared.dependencies = ["group_a"]
	check(not Catalog.validate(mutated).is_empty(), "reject dependency cycle")
	mutated = catalog.duplicate(true)
	mutated.packs.group_a.sha256 = "bad"
	check(not Catalog.validate(mutated).is_empty(), "reject bad hash")
	mutated = catalog.duplicate(true)
	mutated.packs.group_a.file = "../bad.pck"
	check(not Catalog.validate(mutated).is_empty(), "reject pack filename traversal")
	mutated = catalog.duplicate(true)
	mutated.platform = "WrongPlatform"
	check(not Catalog.validate(mutated).is_empty(), "reject incompatible platform")
	var engine := Engine.get_version_info()
	mutated = catalog.duplicate(true)
	mutated.engine = "%s.%s" % [engine.major, engine.minor]
	check(Catalog.validate(mutated).is_empty(), "accept matching engine minor")
	mutated.engine = "%s.%s" % [engine.major, engine.minor - 1]
	check(Catalog.validate(mutated).is_empty(), "accept older content on a newer minor")
	mutated.engine = "%s.%s" % [engine.major, engine.minor + 1]
	check(not Catalog.validate(mutated).is_empty(), "reject content requiring a newer engine")
	mutated.engine = "%s.0" % [engine.major + 1]
	check(not Catalog.validate(mutated).is_empty(), "reject a different future major")
	mutated.engine = "%s.0" % [engine.major - 1]
	check(not Catalog.validate(mutated).is_empty(), "reject a different older major")
	for invalid_version in [null, 4.6, 4, "", "4", "4.6.3", "4.x", "-4.6", "4.-1", "04.6", "4.06", "4.+6", "4. 6"]:
		mutated.engine = invalid_version
		check(not Catalog.validate(mutated).is_empty(), "reject malformed engine metadata: " + str(invalid_version))
	mutated.erase("engine")
	check(Catalog.validate(mutated).is_empty(), "omitted engine defaults to current host")
	for frame in range(3):
		await tree.process_frame
	print("PASS editor/build suite (%s checks)" % checks)
	tree.quit(0)
